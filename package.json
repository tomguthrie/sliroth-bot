{
  "name": "sliroth-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "oxfmt --check && pnpm run lint && pnpm run typecheck",
    "db:check:twitch-subscription": "drizzle-kit check --config=drizzle/twitch-subscription.config.ts",
    "db:check:youtube-subscription": "drizzle-kit check --config=drizzle/youtube-subscription.config.ts",
    "db:generate:twitch-subscription": "drizzle-kit generate --config=drizzle/twitch-subscription.config.ts",
    "db:generate:youtube-subscription": "drizzle-kit generate --config=drizzle/youtube-subscription.config.ts",
    "deploy": "wrangler deploy && pnpm run discord:sync-commands",
    "dev": "wrangler dev",
    "discord:sync-commands": "node scripts/sync-discord-commands.mjs",
    "fmt": "oxfmt",
    "lint": "oxlint --deny-warnings src test drizzle scripts",
    "test": "WRANGLER_LOG=error vitest run",
    "test:watch": "WRANGLER_LOG=error vitest",
    "typecheck": "wrangler types --check && tsc --noEmit && tsc --project test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "itty-router": "^5.0.24",
    "txml": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@types/node": "^26.5.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  }
}
