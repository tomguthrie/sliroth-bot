{
  "name": "sliroth-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "cf-typegen": "cf workers types",
    "check": "oxfmt --check && pnpm run lint && pnpm run typecheck",
    "db:check:twitch-subscription": "drizzle-kit check --config=drizzle/twitch-subscription.config.ts",
    "db:check:youtube-subscription": "drizzle-kit check --config=drizzle/youtube-subscription.config.ts",
    "db:generate:twitch-subscription": "drizzle-kit generate --config=drizzle/twitch-subscription.config.ts",
    "db:generate:youtube-subscription": "drizzle-kit generate --config=drizzle/youtube-subscription.config.ts",
    "deploy": "cf deploy",
    "dev": "cf dev",
    "discord:sync-commands": "node scripts/sync-discord-commands.mjs",
    "fmt": "oxfmt",
    "lint": "oxlint --deny-warnings src test drizzle scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit && tsc --project test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.5-5935859",
    "itty-router": "^5.0.24",
    "txml": "^6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@types/node": "^26.6.3",
    "cf": "1.0.0-beta.10",
    "drizzle-kit": "^1.0.0-rc.4",
    "oxfmt": "^0.71.0",
    "oxlint": "~1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "8.3.2",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  }
}
