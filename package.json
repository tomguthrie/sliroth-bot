{
  "name": "sliroth-bot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "pnpm deploy:worker && pnpm discord:sync-commands",
    "deploy:worker": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "pnpm db:generate:youtube-subscription && pnpm db:generate:twitch-subscription",
    "db:generate:twitch-subscription": "drizzle-kit generate --config=drizzle/twitch-subscription.config.ts",
    "db:generate:youtube-subscription": "drizzle-kit generate --config=drizzle/youtube-subscription.config.ts",
    "discord:sync-commands": "node scripts/sync-discord-commands.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "itty-router": "^5.0.24",
    "txml": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
