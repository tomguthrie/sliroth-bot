{
  "name": "sliroth-bot",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "npm run deploy:worker && npm run discord:sync-commands",
    "deploy:worker": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:generate": "npm run db:generate:youtube-subscription && npm run db:generate:twitch-subscription",
    "db:generate:twitch-subscription": "drizzle-kit generate --config=drizzle/twitch-subscription.config.ts",
    "db:generate:youtube-subscription": "drizzle-kit generate --config=drizzle/youtube-subscription.config.ts",
    "discord:sync-commands": "node scripts/sync-discord-commands.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true,
    "workerd@1.20260310.1": true,
    "workerd@1.20260801.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "fast-xml-parser": "^5.10.1",
    "itty-router": "^5.0.24"
  }
}
