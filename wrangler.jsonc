/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sliroth-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
    },
  },
  "upload_source_maps": true,
  "secrets": {
    "required": [
      "DISCORD_BOT_TOKEN",
      "DISCORD_PUBLIC_KEY",
      "PUBLIC_BASE_URL",
      "TWITCH_CLIENT_ID",
      "TWITCH_CLIENT_SECRET",
      "TWITCH_EVENTSUB_SECRET",
    ],
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "YOUTUBE_SUBSCRIPTIONS",
        "class_name": "YouTubeSubscription",
      },
      {
        "name": "TWITCH_SUBSCRIPTIONS",
        "class_name": "TwitchSubscription",
      },
    ],
  },
  "kv_namespaces": [
    {
      "binding": "TOKEN_STORE",
    },
    {
      "binding": "TWITCH_EVENT_IDS",
    },
    {
      "binding": "TWITCH_SUBSCRIPTIONS_INDEX",
    },
    {
      "binding": "YOUTUBE_SUBSCRIPTIONS_INDEX",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DISCORD_MESSAGES",
        "queue": "discord-messages",
      },
    ],
    "consumers": [
      {
        "queue": "discord-messages",
        "max_batch_size": 10,
        "max_batch_timeout": 0,
        "max_retries": 5,
        "dead_letter_queue": "discord-messages-dlq",
        "max_concurrency": 1,
        "retry_delay": 30,
      },
    ],
  },
  "exports": {
    "YouTubeSubscription": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "TwitchSubscription": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
